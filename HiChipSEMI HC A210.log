                        -b buffering: 0/1
                        -d img_dis_mode: 1, full screen; 2, realsize; 4, auto(pillbox or letterbox)
                        -t time: 0< time < 1, start_time = total_duration * time; time >= 1, start_time = time(seconds)
                        -r rotate: 1, 90; 2, 180; 3, 270; 4, only enable rotate
